# Build output: any build directory (build/, build-asan/, build-m3-trailerSpec/, ...)
build*/
out/
cmake-build-*/

# IDE / editor files
.vs/
*.user
.idea/
CMakeUserPresets.json

# VS Code: the IntelliSense config is shared (it points at the compile
# database, so it works on any machine); everything else here is local.
.vscode/*
!.vscode/c_cpp_properties.json
.vscode/settings.json
.vscode/*.log

# OS cruft
.DS_Store
Thumbs.db

# Local test fixtures (not committed -- confidential customer data)
# Currently: Demand-1.json, PlaceHolder-1.json, Customer2-Product-Data.csv
tests/importer/*.json
tests/importer/*.csv
# September extracts keep the client's directory layout, so they are nested
# and the flat patterns above do not reach them.
tests/importer/crossDay/
# The 4-6 August runs (inputs and Truck Builder solutions), nested the same way.
tests/importer/august/

# CLI output captured from real extracts: full per-lane client data.
/m2_run_*.txt
/run_*.txt


# Root-level working notes and drafts: documents live in docs/; README.md stays tracked.
/*.md
!/README.md

# Archives (client extract packages, review packages): commit the unpacked synthetic files only.
*.zip
*.7z

# Client extract files wherever they land (names as the client's systems write them).
**/Demand-*.json
**/PH-Aug*.json
**/*-STR-*.json
**/*PLACEHOLDER*.json
**/Customer2-*.csv
**/AutoO2-Testing-Data-*

# M1 run summaries written at the root from real extracts.
/M1_Output_*.txt
/m1Output*.txt

# Temp files the params tests used to write, and stray logs.
tests/params/_tmp_*.json
*.log

# Compiler output outside a build folder (e.g. a helper built in the source tree).
*.obj
*.exe
*.pdb
*.ilk

# Tom's reference figures for the real-data comparison: local only, read by tests/m5/testM5RealData.cpp.
tests/m5/data/*.local.json
