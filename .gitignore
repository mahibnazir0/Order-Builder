# Build output
build/
out/
cmake-build-*/
build-linux/

# IDE / editor files
.vs/
*.user
.idea/
CMakeUserPresets.json

# VS Code: the IntelliSense config is shared (it points at the compile
# database, so it works on any machine); everything else here is local.
.vscode/*
!.vscode/c_cpp_properties.json
.vscode/settings.json
.vscode/*.log

# OS cruft
.DS_Store
Thumbs.db

# Local test fixtures (not committed -- confidential customer data)
# Currently: Demand-1.json, PlaceHolder-1.json, Customer2-Product-Data.csv
tests/importer/*.json
tests/importer/*.csv
# September extracts keep the client's directory layout, so they are nested
# and the flat patterns above do not reach them.
tests/importer/crossDay/

# CLI output captured from real extracts: full per-lane client data.
/m2_run_*.txt
/run_*.txt

